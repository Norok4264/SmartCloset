# Local development only. Never commit a real credential.
APP_ENV=development
TRYON_PROVIDER=disabled
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-northeast1
TRYON_MODEL=virtual-try-on-001
TRYON_STORAGE_DIR=./var/tryon
TRYON_DATABASE=./var/tryon.sqlite3
TRYON_MAX_IMAGE_BYTES=7340032
TRYON_DAILY_LIMIT=3
TRYON_RETENTION_HOURS=24
TRYON_PROVIDER_TIMEOUT_SECONDS=180

# Production: run on a private network behind HTTPS ingress; use workload identity
# or Application Default Credentials from the hosting platform. Do not set API keys here.
